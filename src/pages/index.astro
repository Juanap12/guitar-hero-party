---
import Layout from '../layouts/Layout.astro';
import { listAllSongs } from '../lib/songs';
import type { Song } from '../types/song';

const songs: Song[] = await listAllSongs();
---

<Layout title="Setlist | Guitar Hero Party" activeNav="setlist">
	<div class="sticky top-0 z-20 -mx-4 border-b border-stage-border bg-stage-bg/95 px-4 py-3 backdrop-blur sm:-mx-6 sm:px-6">
		<label class="sr-only" for="catalog-search">Search catalog</label>
		<input
			id="catalog-search"
			type="search"
			autocomplete="off"
			placeholder="Search songs or bands..."
			class="w-full rounded-xl border border-stage-border bg-black/50 px-4 py-3 text-base text-white placeholder:text-zinc-500 focus:border-stage-cyan focus:outline-none focus:ring-2 focus:ring-stage-cyan/30"
		/>
		<p id="catalog-count" class="mt-2 text-xs text-zinc-500"></p>
	</div>

	<div id="catalog-root" class="mt-6 space-y-8"></div>

	<div
		id="reserve-modal"
		class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4"
		role="dialog"
		aria-modal="true"
		aria-labelledby="reserve-modal-title"
	>
		<div class="w-full max-w-lg rounded-2xl border border-stage-neon/40 bg-stage-panel p-6 shadow-neon">
			<h2 id="reserve-modal-title" class="font-display text-3xl text-white">Reserve song</h2>
			<p id="reserve-modal-subtitle" class="mt-1 text-sm text-zinc-400"></p>
			<form id="reserve-form" class="mt-5 grid gap-3 sm:grid-cols-2">
				<label class="block text-xs uppercase tracking-wide text-zinc-400">
					Voice
					<input
						name="singer"
						maxlength="80"
						class="mt-1 w-full rounded-lg border border-stage-border bg-black/40 px-3 py-2 text-sm text-white"
					/>
				</label>
				<label class="block text-xs uppercase tracking-wide text-zinc-400">
					Guitar 1
					<input
						name="guitar_1"
						maxlength="80"
						class="mt-1 w-full rounded-lg border border-stage-border bg-black/40 px-3 py-2 text-sm text-white"
					/>
				</label>
				<label class="block text-xs uppercase tracking-wide text-zinc-400">
					Guitar 2
					<input
						name="guitar_2"
						maxlength="80"
						class="mt-1 w-full rounded-lg border border-stage-border bg-black/40 px-3 py-2 text-sm text-white"
					/>
				</label>
				<label class="block text-xs uppercase tracking-wide text-zinc-400">
					Drums
					<input
						name="drums"
						maxlength="80"
						class="mt-1 w-full rounded-lg border border-stage-border bg-black/40 px-3 py-2 text-sm text-white"
					/>
				</label>
				<p id="reserve-error" class="hidden sm:col-span-2 text-sm text-red-400"></p>
				<div class="sm:col-span-2 flex flex-wrap gap-2 pt-1">
					<button
						type="submit"
						class="rounded-lg bg-stage-neon px-4 py-2 text-xs font-bold uppercase tracking-wide text-black"
					>
						Add to queue
					</button>
					<button
						type="button"
						id="reserve-cancel"
						class="rounded-lg border border-stage-border px-4 py-2 text-xs font-semibold uppercase text-zinc-300"
					>
						Cancel
					</button>
				</div>
			</form>
		</div>
	</div>
</Layout>

<script define:vars={{ songs }}>
	/** @typedef {import('../types/song').Song} Song */

	/** @type {Song[]} */
	let catalog = structuredClone(songs);

	/** @type {number | null} */
	let selectedSongId = null;

	const catalogRoot = document.getElementById('catalog-root');
	const searchInput = document.getElementById('catalog-search');
	const catalogCount = document.getElementById('catalog-count');
	const modal = document.getElementById('reserve-modal');
	const reserveForm = document.getElementById('reserve-form');
	const reserveCancel = document.getElementById('reserve-cancel');
	const reserveSubtitle = document.getElementById('reserve-modal-subtitle');
	const reserveError = document.getElementById('reserve-error');

	function statusClass(status) {
		if (status === 'AVAILABLE') return 'border-stage-lime/40 text-stage-lime bg-stage-lime/10';
		if (status === 'RESERVED') return 'border-stage-amber/40 text-stage-amber bg-stage-amber/10';
		return 'border-zinc-500/40 text-zinc-300 bg-zinc-500/10';
	}

	function escapeHtml(value) {
		return value
			.replaceAll('&', '&amp;')
			.replaceAll('<', '&lt;')
			.replaceAll('>', '&gt;')
			.replaceAll('"', '&quot;');
	}

	function filteredSongs() {
		const query = searchInput instanceof HTMLInputElement ? searchInput.value.trim().toLowerCase() : '';
		if (!query) return catalog;
		return catalog.filter(
			(song) => song.title.toLowerCase().includes(query) || song.band.toLowerCase().includes(query),
		);
	}

	function groupByBand(items) {
		/** @type {Record<string, Song[]>} */
		const groups = {};
		for (const song of items) {
			if (!groups[song.band]) groups[song.band] = [];
			groups[song.band].push(song);
		}
		return Object.entries(groups).sort(([a], [b]) => a.localeCompare(b));
	}

	function renderCatalog() {
		if (!(catalogRoot instanceof HTMLElement)) return;
		const visible = filteredSongs();
		const groups = groupByBand(visible);

		if (catalogCount) {
			catalogCount.textContent = `${visible.length} song${visible.length === 1 ? '' : 's'} shown`;
		}

		if (!visible.length) {
			catalogRoot.innerHTML =
				'<p class="rounded-xl border border-dashed border-stage-border p-8 text-center text-zinc-400">No songs match your search.</p>';
			return;
		}

		catalogRoot.innerHTML = groups
			.map(
				([band, bandSongs]) => `
				<section>
					<h2 class="mb-3 font-display text-3xl text-stage-amber">${escapeHtml(band)}</h2>
					<ul class="grid gap-3 sm:grid-cols-2">
						${bandSongs
							.map(
								(song) => `
							<li class="rounded-xl border border-stage-border bg-stage-panel/90 p-4">
								<div class="flex items-start justify-between gap-3">
									<div>
										<h3 class="font-display text-2xl leading-tight text-white">${escapeHtml(song.title)}</h3>
									</div>
									<span class="rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase ${statusClass(song.status)}">${song.status}</span>
								</div>
								${
									song.status === 'AVAILABLE'
										? `<button type="button" data-reserve-id="${song.id}" class="reserve-btn mt-3 rounded-lg bg-stage-neon px-3 py-2 text-xs font-bold uppercase tracking-wide text-black">Reserve</button>`
										: song.status === 'PLAYED'
											? `<button type="button" data-reopen-id="${song.id}" class="reopen-btn mt-3 rounded-lg border border-stage-cyan/50 px-3 py-2 text-xs font-bold uppercase tracking-wide text-stage-cyan">🔄 Re-open Song</button>`
											: '<p class="mt-3 text-xs text-zinc-500">In queue — manage from Stage Queue</p>'
								}
							</li>
						`,
							)
							.join('')}
					</ul>
				</section>
			`,
			)
			.join('');

		document.querySelectorAll('.reserve-btn').forEach((button) => {
			button.addEventListener('click', () => {
				const id = Number((/** @type {HTMLButtonElement} */ (button)).dataset.reserveId);
				openReserveModal(id);
			});
		});

		document.querySelectorAll('.reopen-btn').forEach((button) => {
			button.addEventListener('click', async () => {
				const id = Number((/** @type {HTMLButtonElement} */ (button)).dataset.reopenId);
				await setSongAvailable(id);
			});
		});
	}

	async function setSongAvailable(id) {
		const response = await fetch('/api/status', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ id, status: 'AVAILABLE' }),
		});
		if (!response.ok) {
			const payload = await response.json();
			alert(payload.error ?? 'Could not re-open song');
			return;
		}
		catalog = catalog.map((song) =>
			song.id === id
				? {
						...song,
						status: 'AVAILABLE',
						singer: null,
						guitar_1: null,
						guitar_2: null,
						drums: null,
						reserved_at: null,
					}
				: song,
		);
		renderCatalog();
	}

	function openReserveModal(id) {
		const song = catalog.find((entry) => entry.id === id);
		if (!song || song.status !== 'AVAILABLE') return;
		selectedSongId = id;
		if (reserveSubtitle) {
			reserveSubtitle.textContent = `${song.title} — ${song.band}`;
		}
		if (reserveError) {
			reserveError.textContent = '';
			reserveError.classList.add('hidden');
		}
		if (reserveForm instanceof HTMLFormElement) {
			reserveForm.reset();
		}
		if (modal) {
			modal.classList.remove('hidden');
			modal.classList.add('flex');
		}
	}

	function closeReserveModal() {
		selectedSongId = null;
		if (modal) {
			modal.classList.add('hidden');
			modal.classList.remove('flex');
		}
	}

	searchInput?.addEventListener('input', renderCatalog);
	reserveCancel?.addEventListener('click', closeReserveModal);
	modal?.addEventListener('click', (event) => {
		if (event.target === modal) closeReserveModal();
	});

	reserveForm?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!selectedSongId || !(reserveForm instanceof HTMLFormElement)) return;

		const data = new FormData(reserveForm);
		const response = await fetch('/api/reserve', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({
				id: selectedSongId,
				singer: data.get('singer'),
				guitar_1: data.get('guitar_1'),
				guitar_2: data.get('guitar_2'),
				drums: data.get('drums'),
			}),
		});

		if (!response.ok) {
			const payload = await response.json();
			if (reserveError) {
				reserveError.textContent = payload.error ?? 'Could not reserve song';
				reserveError.classList.remove('hidden');
			}
			return;
		}

		catalog = catalog.map((song) =>
			song.id === selectedSongId
				? {
						...song,
						status: 'RESERVED',
						singer: String(data.get('singer') || '').trim() || null,
						guitar_1: String(data.get('guitar_1') || '').trim() || null,
						guitar_2: String(data.get('guitar_2') || '').trim() || null,
						drums: String(data.get('drums') || '').trim() || null,
						reserved_at: new Date().toISOString(),
					}
				: song,
		);
		closeReserveModal();
		renderCatalog();
	});

	renderCatalog();
</script>
